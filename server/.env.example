PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=1
MONGODB_URI=mongodb://localhost:27017/luxecart
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Optional: Set only when frontend and backend use subdomains
# of the same custom apex domain.
# Leave unset for separate vercel.app and onrender.com domains.
# COOKIE_DOMAIN=.yourdomain.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=luxecart/products
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=LuxeCart <onboarding@resend.dev>
