# Backend API Base URL
# IMPORTANT: Vite embeds this value into the static frontend bundle at build time.
# For Vercel or any production/staging deployment, this variable MUST be configured
# in the hosting dashboard (e.g. Vercel Environment Variables) before triggering the build.
# Local Development: http://localhost:5000/api/v1
# Staging/Production Example:
VITE_API_URL=https://your-staging-api.onrender.com/api/v1

# Google OAuth 2.0 Web Client ID (Public)
# Optional: Used for Google Identity Services One-Tap and Sign-In buttons
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
